{
  "name": "@deepwhale-cn/dsh-cn-doc-formatter",
  "version": "0.1.2",
  "description": "中文公文排版：按 GB/T 9704-2012 生成 .docx / .pdf / .txt，附输出自检。不含字体文件，字体由用户自备。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "skill",
    "docx",
    "pdf",
    "公文",
    "排版",
    "仿宋",
    "GB/T 9704",
    "chinese",
    "document",
    "formatting",
    "government-document",
    "gbt9704",
    "typesetting",
    "official-document"
  ],
  "files": [
    "lib",
    "skill",
    "fonts",
    "cordis.patch.yml",
    "README.md"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feely0208/dsh-cn-skills.git",
    "directory": "dsh-cn-doc-formatter"
  },
  "homepage": "https://github.com/feely0208/dsh-cn-skills#readme",
  "bugs": {
    "url": "https://github.com/feely0208/dsh-cn-skills/issues"
  }
}
