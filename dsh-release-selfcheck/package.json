{
  "name": "@deepwhale-cn/dsh-release-selfcheck",
  "version": "0.1.0",
  "description": "软件发布前的自检：产物清单比对（防止把无关文件一起上传）、版本一致性、平台与架构正确性、上传内容过滤、上线前逐链接 404 检查、发布纪律与现场清理。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "skill",
    "release",
    "ci",
    "selfcheck",
    "发布自检",
    "上架检查",
    "cd",
    "preflight",
    "artifact-verification",
    "deployment",
    "quality-gate"
  ],
  "files": [
    "lib",
    "skill",
    "cordis.patch.yml",
    "README.md"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feely0208/dsh-cn-skills.git",
    "directory": "dsh-release-selfcheck"
  },
  "homepage": "https://github.com/feely0208/dsh-cn-skills#readme",
  "bugs": {
    "url": "https://github.com/feely0208/dsh-cn-skills/issues"
  }
}
